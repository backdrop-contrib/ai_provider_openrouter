<?php

/**
 * Implements hook_install().
 */
function ai_provider_openrouter_install() {
  if (!module_load_install('ai_upgrade')) { return []; }
  ai_upgrade_module_install('ai_provider_openrouter');
}

/**
 * Copy legacy OpenRouter provider configuration into the AI namespace.
 *
 * Non-destructive: legacy config is kept and the legacy module stays enabled
 * until the operator completes the cutover with AI Upgrade.
 */
function ai_provider_openrouter_update_1000() {
  if (!module_load_install('ai_upgrade')) {
    return t('AI Upgrade helpers unavailable; legacy OpenRouter provider configuration not migrated.');
  }
  $result = ai_upgrade_module_install('ai_provider_openrouter');
  return t('Copied @count legacy OpenRouter provider config object(s).', ['@count' => $result['migrated']]);
}

/**
 * Implements hook_requirements().
 */
function ai_provider_openrouter_requirements($phase) {
  if (!module_load_install('ai_upgrade')) { return []; }
  return ai_upgrade_module_requirements($phase, 'ai_provider_openrouter');
}
