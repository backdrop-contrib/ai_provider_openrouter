<?php

/**
 * @file
 * Install, update and uninstall functions for the OpenRouter module.
 */

/**
 * Implements hook_install().
 */
function openai_openrouter_install() {
  // Create the config with an empty enabled_models array
  // This ensures that NO models are shown until admin explicitly enables them
  $config = config('openai_openrouter.settings');
  $config->set('enabled_models', []);
  $config->save();
}

/**
 * Implements hook_uninstall().
 */
function openai_openrouter_uninstall() {
  // Remove the configuration
  $config = config('openai_openrouter.settings');
  $config->delete();
}
